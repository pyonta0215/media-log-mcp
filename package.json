{
  "name": "media-log-mcp",
  "version": "0.4.0",
  "description": "メディア台帳（本・映画・アニメ・ゲーム等）を検索・登録・編集する MCP サーバーとローカル Web UI",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "start:remote": "node app.mjs",
    "web": "node web.mjs",
    "test": "node --test test/*.test.mjs",
    "build:lambda": "sh scripts/build-lambda.sh",
    "deploy": "sh scripts/build-lambda.sh && sam deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@codegenie/serverless-express": "4.17.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "4.22.2",
    "zod": "4.4.3"
  }
}
